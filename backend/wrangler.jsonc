{
  "$schema": "https://schemas.cloudflare.com/wrangler.json",
  "name": "sande-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sande-platform",
      "database_id": "PLACEHOLDER_PLATFORM_DB_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BACKUPS",
      "bucket_name": "sande-backups"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "PLACEHOLDER_SESSION_KV_ID"
    },
    {
      "binding": "RATE_LIMIT_KV",
      "id": "PLACEHOLDER_RATE_LIMIT_KV_ID"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_COORDINATOR",
        "class_name": "SyncCoordinator"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      {
        "name": "nightly-backup",
        "schedule": "0 3 * * *"
      },
      {
        "name": "cleanup-sync-exceptions",
        "schedule": "0 4 * * *"
      },
      {
        "name": "lease-expiry-check",
        "schedule": "0 */6 * * *"
      }
    ]
  },
  "dispatch_namespaces": {
    "dispatch_namespace": "sande-backend"
  },
  "workflows": [
    {
      "name": "backup-workflow",
      "class_name": "BackupWorkflow"
    }
  ]
}
